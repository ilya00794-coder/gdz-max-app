# Ключ Claude API — https://console.anthropic.com/
# Никогда не коммить реальный ключ: .env в .gitignore.
ANTHROPIC_API_KEY=sk-ant-...

# Необязательно: модель для распознавания фото (по умолчанию claude-opus-5).
# VISION_MODEL=claude-opus-5

# Необязательно: глубина рассуждений на этапе распознавания.
# low | medium | high | xhigh | max (по умолчанию medium).
# VISION_EFFORT=medium

# Необязательно: модель и глубина рассуждений на этапе решения задачи.
# По умолчанию claude-opus-5 и effort=high — на решении экономить не стоит.
# SOLVER_MODEL=claude-opus-5
# SOLVER_EFFORT=high

# Необязательно: модель и глубина рассуждений при пошаговом сравнении работы ученика.
# COMPARE_MODEL=claude-opus-5
# COMPARE_EFFORT=high

# Необязательно: интерпретатор Python для символьной верификации (verify.js → verify_sympy.py).
# PYTHON_BIN=python3

# Необязательно: таймаут одного вызова SymPy, мс (по умолчанию 5000).
# VERIFY_TIMEOUT_MS=5000

# Токен бота MAX (business.max.ru). Нужен для проверки подписи initData от MAX Bridge.
# Пока подпись только логируется, но без токена статус будет "no_token".
# MAX_BOT_TOKEN=

# Строгая проверка строки запуска MAX. По умолчанию выключена: мидлвара только
# наблюдает и логирует. Включать осознанно, когда будем готовы блокировать
# неподписанные запросы. Локальные запросы пропускаются и при включённой проверке.
# STRICT_INIT_DATA=false

# Окно годности строки запуска в секундах (по умолчанию сутки).
# MAX_INIT_DATA_MAX_AGE=86400

# ID канала для gating (добывается npm run catch-chat-id, держать строкой).
# MAX_CHANNEL_CHAT_ID=

# Gating по подписке на канал: off (по умолчанию) | shadow (только лог) | on (403 неподписанным).
# on требует STRICT_INIT_DATA=on, иначе сервер не стартует.

# Вайтлист публикаторов постов через личку бота (id через запятую).
# Пустой = бот никому не отвечает, входящие id только логируются.
# Соль необратимого хэша пользователей в телеметрии (openssl rand -hex 32).
# Без неё user_hash не пишется. Менять соль = потерять связность истории.
# USER_HASH_SALT=

# Режим конкурса роликов: любое http/https в сообщении не-админа = заявка
# (contest_entries). Выключено = прежнее поведение (автоответ про приложение).
# CONTEST_MODE=off

# MAX_ADMIN_USER_IDS=
# SUBSCRIPTION_GATING=off

# Хост Bot API. По умолчанию platform-api.max.ru: у api2 сертификат Минцифры.
# MAX_API_HOST=platform-api.max.ru

# Детектор возможной ошибки распознавания: сверка числовых равенств в работе
# ученика через SymPy. off по умолчанию; on — только пишет possibly_misread в лог,
# ответ пользователю и вердикт не меняет. Числа никогда не исправляются.
# MISREAD_DETECTION=off

# Postgres для кэша решений. Для локальной разработки достаточно значения по умолчанию.
DATABASE_URL=postgresql://localhost/gdz_max

# PORT=3000

# ВРЕМЕННЫЙ сбор образцов (фото+vision) в ~/gdz-samples для ручного разбора.
# Читается ОДИН РАЗ при старте: выключение требует рестарта бэкенда.
# Ретенция 48ч — launchd com.gdz.samples-gc. По умолчанию off.
COLLECT_SAMPLES=off

# Детектор неполного условия (обрыв кадра / ссылка на другое задание /
# нечитаемый текст) — отказ ДО solver. АВАРИЙНОЕ выключение: off + рестарт
# (флаг читается один раз при старте).
INCOMPLETE_DETECTOR=on

# Qwen-solve за флагом (11.09): solve через qwen-flash (DashScope, Anthropic-
# совместимый endpoint). off (дефолт) — выключено; canary — qwen ТОЛЬКО для
# запросов с X-Canary; on — qwen на все solve (ретрай ×1 → фолбэк Haiku).
# Vision/compare/misread не трогаются (Opus). АВАРИЙКА: off + рестарт.
# Стрим шагов при qwen не работает — шаги приходят разом (parse-путь).
QWEN_SOLVE=off
# QWEN_API_KEY=sk-ws-...
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/apps/anthropic

# Шаг 2 переезда (12.09): родной Qwen-формат для solve. off — прослойка (как
# было); canary — родной ТОЛЬКО для X-Canary; on — родной для всех.
# Фолбэк родного пути: qwen-flash ×2 → qwen3.8-flash. Аварийка: QWEN_SOLVE=off.
QWEN_NATIVE=off

# Шаг 3 переезда (12.09): vision на родном Qwen. off — Opus (как было);
# canary — qwen ТОЛЬКО для X-Canary; on — qwen3-vl-flash ×2 → qwen3-vl-plus.
# При qwen-vision рукописные фото+текст пишутся в ~/gdz-handwriting-audit
# (аудит семейных ошибок, ретенция 7 дней — com.gdz.handwriting-gc).
QWEN_VISION=off
