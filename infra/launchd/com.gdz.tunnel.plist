<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Туннель ngrok под launchd (03.09.2026). Домен ФИКСИРОВАННЫЙ — автоподъём
  безопасен (смена адреса не грозит; предусловие из бэклога выполнено).
  Конфиг с authtoken ngrok читает сам из ~/Library/Application Support/ngrok.
  KeepAlive ловит СМЕРТЬ процесса; случай «жив, но туннель не проходит»
  ловит сторож работоспособности (см. session-state / tunnelWatch).
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.gdz.tunnel</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/ngrok</string>
    <string>http</string>
    <string>3000</string>
    <string>--domain=whacking-ramble-womb.ngrok-free.dev</string>
    <string>--log=stdout</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/Users/ilya/gdz-ngrok.log</string>
  <key>StandardErrorPath</key><string>/Users/ilya/gdz-ngrok.log</string>
</dict>
</plist>
